# API
API_PORT=4000
API_URL=http://localhost:4000

# MongoDB: docker compose из репозитория слушает localhost:27019
MONGODB_URI=mongodb://localhost:27019/service_desk
MONGODB_USER=service_desk
MONGODB_PASSWORD=service_desk_dev
MONGODB_AUTH_SOURCE=admin
# Свой MongoDB на 27017 без docker — смените хост/порт и учётные данные:
# MONGODB_URI=mongodb://localhost:27017/service_desk

SESSION_SECRET=change-me-in-production-min-32-chars
WEB_ORIGIN=http://localhost:3000
# Email (optional for dev — logs to console if SMTP_* не заданы)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=service-desk
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# Telegram: коды регистрации + оповещения по заявкам (если заданы TOKEN и USERNAME — привязка обязательна)
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — показывается заказчикам и исполнителям в профиле (например MyServiceDeskBot)
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta) — код регистрации; без токена код пишется в консоль API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Шаблон OTP в Meta Business (рекомендуется для production)
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=ru
WHATSAPP_DEFAULT_COUNTRY_CODE=7

# Next.js (в dev запросы с сайта идут через прокси Next на API; достаточно pnpm dev)
NEXT_PUBLIC_API_URL=http://localhost:4000
